/* Type checks the mock nexus (`npm run check:mock`); Node runs it as is. */
{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
