# Maintainer: odolha <odolha@gmail.com>
#
# Builds Shed from this source tree:   cd packaging/arch && makepkg -si
# For the AUR, point `source` at a release tarball (with its checksum) and
# build in "$srcdir/shed-$pkgver" instead of the tree around this file.
#
# Called shed-terminal: `shed` is already a hex editor, which also installs
# /usr/bin/shed, so the two conflict.

pkgname=shed-terminal
pkgver=0.1.0
pkgrel=1
pkgdesc='Terminal whose shells outlive its windows, with saved workspaces (benches)'
arch=('x86_64' 'aarch64')
license=('MIT OR Apache-2.0')
depends=('fontconfig' 'gcc-libs' 'glibc' 'libglvnd' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11'
         'vulkan-icd-loader' 'wayland')
makedepends=('cargo')
optdepends=('bash: shell integration (logbook, history walking, aliases)'
            'vulkan-driver: GPU rendering')
conflicts=('shed')
source=()
sha256sums=()

_tree="$startdir/../.."

prepare() {
  cd "$_tree"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_tree"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p shed-app -p shed-keeper
}

package() {
  cd "$_tree"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  install -Dm755 "$CARGO_TARGET_DIR/release/shed" "$pkgdir/usr/bin/shed"
  install -Dm755 "$CARGO_TARGET_DIR/release/shedd" "$pkgdir/usr/bin/shedd"
  install -Dm644 packaging/linux/dev.shed.desktop "$pkgdir/usr/share/applications/dev.shed.desktop"
  install -Dm644 packaging/linux/shedd.service "$pkgdir/usr/lib/systemd/user/shedd.service"
  cargo run --frozen --release -q -p shed-desktop --example app_icons -- "$pkgdir/usr/share/icons/hicolor"
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md packaging/linux/copyright
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE-MIT LICENSE-APACHE
}
