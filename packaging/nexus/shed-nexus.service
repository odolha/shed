# The Shed nexus as a system service, as its own unprivileged user, sandboxed.
# See docs/nexus-deploy.md. Install:
#
#   sudo useradd --system --home-dir /var/lib/shed-nexus --shell /usr/sbin/nologin shed-nexus
#   sudo install -m 0755 shed-nexus /usr/local/bin/
#   sudo install -d -m 0755 /etc/shed-nexus
#   sudo install -m 0644 nexus.toml /etc/shed-nexus/
#   sudo install -m 0644 shed-nexus.service /etc/systemd/system/
#   sudo systemctl enable --now shed-nexus
#   journalctl -u shed-nexus     # the setup link, until the account exists
[Unit]
Description=Shed nexus: links Shed workspaces to the web and Android apps
Documentation=file:///usr/local/share/doc/shed-nexus/nexus-deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shed-nexus
Group=shed-nexus
ExecStart=/usr/local/bin/shed-nexus --config /etc/shed-nexus/nexus.toml
Environment=SHED_LOG=info
Restart=on-failure
RestartSec=5
# Stopping writes the workspaces' last states first.
KillSignal=SIGTERM
TimeoutStopSec=15

# Its data: the database and the push key (0700, the user's own).
StateDirectory=shed-nexus
StateDirectoryMode=0700
ReadWritePaths=/var/lib/shed-nexus
UMask=0077

# Sandboxing: nothing but its data folder is writable; no privileges, devices,
# kernel knobs or other users' files.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
